{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": ["fixtures/**/*.ts", "pages/**/*.ts", "tests/**/*.ts", "config.ts", "global-setup.ts", "global-teardown.ts"]
}
